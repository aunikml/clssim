# Environment Variables for Classroom Simulator Backend
SECRET_KEY=dev-secret-key-change-in-production-classsim-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

USE_SQLITE=True
DB_NAME=classroom_simulator
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_CHANNEL_LAYER=True

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# LiveKit Configuration for Spatial Audio
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_classsim_livekit_key_2026
LIVEKIT_URL=wss://livekit.classsim.local
